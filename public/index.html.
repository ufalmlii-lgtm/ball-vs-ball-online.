<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Ball vs Ball Online</title>
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #101827;
      color: white;
      text-align: center;
    }
    header { padding: 18px 10px; }
    h1 { margin: 5px; color: #5eead4; }
    #status { color: #facc15; margin: 10px; }
    canvas {
      display: block;
      width: 100%;
      max-width: 800px;
      height: 55vh;
      min-height: 300px;
      margin: auto;
      background: #172554;
      border: 2px solid #38bdf8;
      border-radius: 12px;
      touch-action: none;
    }
    .controls {
      display: flex;
      justify-content: center;
      gap: 14px;
      padding: 18px;
    }
    button {
      border: 0;
      border-radius: 14px;
      padding: 16px 25px;
      font-size: 20px;
      font-weight: bold;
      background: #22d3ee;
      color: #082f49;
      touch-action: none;
    }
    #restart { font-size: 15px; background: #a7f3d0; }
  </style>
</head>
<body>
  <header>
    <h1>⚽ BALL vs BALL</h1>
    <p>Game arena bola 3D-style</p>
    <div id="status">Bersiap bermain!</div>
  </header>

  <canvas id="game"></canvas>

  <div class="controls">
    <button id="left">◀</button>
    <button id="right">▶</button>
    <button id="jump">⬆</button>
  </div>
  <button id="restart">Main Lagi</button>

  <script>
    const canvas = document.getElementById("game");
    const ctx = canvas.getContext("2d");
    const status = document.getElementById("status");

    let player, enemy, score, keys, running;
    let lastTime = 0;

    function reset() {
      player = { x: 0.25, y: 0.7, vx: 0, vy: 0, r: 19 };
      enemy = { x: 0.75, y: 0.3, vx: -0.15, vy: 0, r: 22 };
      score = 0;
      keys = {};
      running = true;
      status.textContent = "Dorong bola lawan!";
    }

    function resize() {
      const dpr = window.devicePixelRatio || 1;
      canvas.width = canvas.clientWidth * dpr;
      canvas.height = canvas.clientHeight * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function drawBall(x, y, r, color) {
      const g = ctx.createRadialGradient(
        x - r * 0.35, y - r * 0.4, 2, x, y, r
      );
      g.addColorStop(0, "#ffffff");
      g.addColorStop(0.2, color);
      g.addColorStop(1, "#111827");
      ctx.beginPath();
      ctx.arc(x, y, r, 0, Math.PI * 2);
      ctx.fillStyle = g;
      ctx.fill();
      ctx.strokeStyle = "#ffffff99";
      ctx.lineWidth = 2;
      ctx.stroke();
    }

    function frame(time) {
      const dt = Math.min((time - lastTime) / 1000 || 0, 0.03);
      lastTime = time;
      const w = canvas.clientWidth, h = canvas.clientHeight;

      ctx.clearRect(0, 0, w, h);
      ctx.fillStyle = "#14532d";
      ctx.fillRect(0, 0, w, h);

      ctx.strokeStyle = "#ffffff55";
      ctx.lineWidth = 2;
      ctx.strokeRect(12, 12, w - 24, h - 24);
      ctx.beginPath();
      ctx.moveTo(w / 2, 12);
      ctx.lineTo(w / 2, h - 12);
      ctx.stroke();
      ctx.beginPath();
      ctx.arc(w / 2, h / 2, 45, 0, Math.PI * 2);
      ctx.stroke();

      if (running) {
        const speed = 250;
        if (keys.left) player.vx -= speed * dt;
        if (keys.right) player.vx += speed * dt;
        if (keys.jump && player.y > 0.15) player.vy = -180;

        player.vy += 350 * dt;
        player.x += player.vx * dt / w;
        player.y += player.vy * dt / h;
        player.vx *= 0.96;
        player.vy *= 0.99;

        enemy.x += enemy.vx * dt;
        enemy.y += enemy.vy * dt;
        enemy.vx += (player.x - enemy.x) * dt * 0.3;
        enemy.vy += (player.y - enemy.y) * dt * 0.3;

        player.x = Math.max(0.08, Math.min(0.92, player.x));
        player.y = Math.max(0.12, Math.min(0.88, player.y));

        if (enemy.x < 0.08 || enemy.x > 0.92) enemy.vx *= -1;
        if (enemy.y < 0.12 || enemy.y > 0.88) enemy.vy *= -1;

        const dx = (player.x - enemy.x) * w;
        const dy = (player.y - enemy.y) * h;
        const distance = Math.hypot(dx, dy);
        if (distance < player.r + enemy.r && distance > 0) {
          enemy.vx = -dx / distance * 0.6;
          enemy.vy = -dy / distance * 0.6;
          score++;
          status.textContent = "Benturan: " + score;
        }
      }

      ctx.fillStyle = "white";
      ctx.font = "bold 16px Arial";
      ctx.fillText("KAMU", 18, 28);
      ctx.fillText("LAWAN", w - 78, 28);

      drawBall(player.x * w, player.y * h, player.r, "#06b6d4");
      drawBall(enemy.x * w, enemy.y * h, enemy.r, "#f97316");

      requestAnimationFrame(frame);
    }

    function bindButton(id, key) {
      const el = document.getElementById(id);
      el.addEventListener("pointerdown", e => {
        e.preventDefault();
        keys[key] = true;
      });
      ["pointerup", "pointercancel", "pointerleave"].forEach(ev =>
        el.addEventListener(ev, () => keys[key] = false)
      );
    }

    bindButton("left", "left");
    bindButton("right", "right");
    bindButton("jump", "jump");
    document.getElementById("restart").onclick = reset;

    window.addEventListener("resize", resize);
    resize();
    reset();
    requestAnimationFrame(frame);
  </script>
</body>
</html>
